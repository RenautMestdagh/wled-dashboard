{
  "name": "wled-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "infisical run --path=/wled -- node --watch src/server.ts",
    "test": "node --test 'test/*.test.ts'",
    "check": "prettier --check . && tsc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "dns-packet": "^5.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dns-packet": "^5.6.5",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
